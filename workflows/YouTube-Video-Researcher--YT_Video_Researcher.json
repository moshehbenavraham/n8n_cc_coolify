        "specifyBody": "json",
        "jsonBody": "={\n  \"requests\":\n    {{ JSON.stringify([\n      {\n        \"repeatCell\": {\n          \"range\": {\n            \"sheetId\": $json.sheets[0].properties.sheetId,\n            \"startRowIndex\": 0,\n            \"endRowIndex\": 1\n          },\n          \"cell\": {\n            \"userEnteredFormat\": {\n              \"textFormat\": {\n                \"bold\": true\n              }\n            }\n          },\n          \"fields\": \"userEnteredFormat.textFormat.bold\"\n        }\n      },\n      {\n      \"appendCells\": {\n        \"sheetId\": $json.sheets[0].properties.sheetId,\n        \"rows\": [\n          {\n            \"values\": [\n              Object.keys($('Augment the videos with the statistics').item.json.videos[0]).map(key => ({\n                \"userEnteredValue\": { \"stringValue\": key }\n              }))\n            ]\n          },\n          ...$('Augment the videos with the statistics').item.json.videos.map(item => ({\n            \"values\": Object.values(item).map(value => ({\n              \"userEnteredValue\": { [typeof value === \"string\" ? \"stringValue\" : \"numberValue\"]: value }\n            }))\n          }))\n        ],\n        \"fields\": \"userEnteredValue\"\n      }\n    }\n    ], null, 2) }}\n}",
