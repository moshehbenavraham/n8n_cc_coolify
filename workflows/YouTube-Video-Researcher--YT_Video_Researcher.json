      "name": "Extract fields we need"
    },
    {
      "parameters": {
        "jsCode": "const channelStatMap = {};\nconst videoStatMap = {};\n\n$('Get video stats for the batch').all().forEach(batchStat => {\n  batchStat.json.items.forEach(statItem => {\n    videoStatMap[statItem.id] = {\n      viewCount: parseInt(statItem.statistics.viewCount),\n      likeCount: parseInt(statItem.statistics.likeCount),\n      commentCount: parseInt(statItem.statistics.commentCount)\n    };\n  });\n})\n  \n$('Get channel stats for the batch').all().forEach(batchStat => {\n  batchStat.json.items.forEach(statItem => {\n    channelStatMap[statItem.id] = {\n      viewCount: parseInt(statItem.statistics.viewCount),\n      videoCount: parseInt(statItem.statistics.videoCount),\n      subscriberCount: parseInt(statItem.statistics.subscriberCount)\n    };\n  })\n})  \n\nconst videos = $('All videos').first().json.videos.map(video => {\n  const videoData = {\n    ...video\n  }\n  if (videoStatMap[video.id]) {\n    videoData.videoStatistics = videoStatMap[video.id];\n  }\n  if (channelStatMap[video.channelId]) {\n    videoData.channelStatistics = channelStatMap[video.channelId]\n  }\n  return videoData;\n})\n  .filter(video => video.videoStatistics?.viewCount > $('Setup defaults').first().json.min_views)\n  .map(video => ({\n    [\"Video view/channel subscribers count ratio\"]: video.videoStatistics.viewCount / video.channelStatistics.subscriberCount,\n    [\"Estimated #searches\"]: video.videoStatistics.viewCount - video.channelStatistics.subscriberCount * 0.3,\n    [\"Video title\"]: video.title,\n    [\"Video link\"]: `https://www.youtube.com/watch?v=${video.id}`,\n    [\"Video view count\"]: video.videoStatistics.viewCount,\n    [\"Video like count\"]: video.videoStatistics.likeCount,\n    [\"Video comment count\"]: video.videoStatistics.commentCount,\n    [\"Video like/view ratio %\"]: video.videoStatistics.likeCount / video.videoStatistics.viewCount,\n    [\"Video like/comment ratio %\"]: video.videoStatistics.commentCount / video.videoStatistics.viewCount,\n    [\"Channel title\"]: video.channelTitle,\n    [\"Channel view count\"]: video.channelStatistics.viewCount,\n    [\"Channel number of videos\"]: video.channelStatistics.videoCount,\n    [\"Channel number of subscribers\"]: video.channelStatistics.subscriberCount,\n    [\"Published\"]: video.publishedAt\n  }))\n  .sort((a, b) => {\n    if (a[\"Video view/channel subscribers count ratio\"] > b[\"Video view/channel subscribers count ratio\"]) {\n      return -1;\n    } else if (a[\"Video view/channel subscribers count ratio\"] < b[\"Video view/channel subscribers count ratio\"]) {\n      return 1;\n    }\n    return 0;\n  })\n\nreturn [{ json: {\n  videos\n} }]"
      },
