    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst batches = [];\nlet batch = [];\nconst batchSize = 50;\nfor (const item of $input.all()) {\n  item.json.videos.forEach(video => {\n    if (batch.length >= batchSize) {\n      batches.push([...batch]);\n      batch = [];\n    }\n  \n    batch.push(video)\n  })\n}\n\nif (batch.length > 0) {\n  batches.push(batch);\n} \n\nreturn batches.map(item => ({\n  json: {\n    videoIds: item.map(video => video.id).join(','),\n    channelIds: item.map(video => video.channelId).join(',')\n  }\n}))"
      },
